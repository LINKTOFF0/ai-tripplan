# ============================================
# AiTripPlan 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ============================================

# 阿里云 DashScope API Key（从 https://dashscope.console.aliyun.com/ 获取）
DASHSCOPE_API_KEY=your-api-key-here

# 高德地图 MCP Server 地址（从 https://console.amap.com/dev/key/app 获取 Web服务 Key）
AMAP_MAP_ADDR=https://mcp.amap.com/sse?key=your-amap-api-key-here

# 使用的语言大模型名称
MODEL_NAME=qwen3-max