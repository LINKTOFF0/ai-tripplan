# ============================================
# AiTripPlan 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ============================================

# 阿里云 DashScope API Key（从 https://dashscope.console.aliyun.com/ 获取）
ALIBABA_DASHCOPE_KEY=your-api-key-here

# 百度地图 MCP Server 地址
BAIDU_MAP_ADDR=your-baidu-map-mcp-endpoint-here

# 使用的语言大模型名称
MODEL_NAME=qwen3-max